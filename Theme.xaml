<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- 1. SOLID DARK PALETTE (NO GRADIENTS) -->
    <!-- Surfaces -->
    <SolidColorBrush x:Key="BrushWindowBg" Color="#0B0F17"/>
    <SolidColorBrush x:Key="BrushSidebarBg" Color="#0E131E"/>
    <SolidColorBrush x:Key="BrushPanelBg" Color="#131924"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#131924"/>
    <SolidColorBrush x:Key="BrushCardBgHover" Color="#182030"/>
    <SolidColorBrush x:Key="BrushElevated" Color="#1A2232"/>
    <SolidColorBrush x:Key="BrushElevatedHover" Color="#222B3F"/>
    
    <!-- Borders -->
    <SolidColorBrush x:Key="BrushBorder" Color="#232C3D"/>
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="#1C2433"/>
    <SolidColorBrush x:Key="BrushBorderFocus" Color="#3B82F6"/>

    <!-- Text -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushTextOnPrimary" Color="#FFFFFF"/>

    <!-- Solid Brand / Action Brushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="#1E40AF"/>

    <!-- Solid Stop / Danger Brushes -->
    <SolidColorBrush x:Key="BrushDangerSurface" Color="#2A161A"/>
    <SolidColorBrush x:Key="BrushDangerBorder" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="BrushDangerForeground" Color="#F87171"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="#3D1C22"/>

    <!-- Status -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#10B981"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BrushError" Color="#EF4444"/>

    <!-- Overlay Backdrop -->
    <SolidColorBrush x:Key="BrushBadgeBackdrop" Color="#E60B0F17"/>
    <SolidColorBrush x:Key="BrushBadgeBorder" Color="#2D3748"/>

    <!-- 2. SCROLLBAR STYLE -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border CornerRadius="3" Background="#263147"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3. TITLEBAR BUTTONS -->
    <Style x:Key="TitleBarBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#1A2232"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#222B3F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="0 14 0 0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#DC2626"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4. BUTTON STYLES -->
    <!-- Solid Blue Action Button -->
    <Style x:Key="PrimaryActionBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextOnPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger / Stop Button -->
    <Style x:Key="DangerActionBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushDangerSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushDangerForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushDangerBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushDangerHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 5. INPUT TEXTBOX -->
    <Style x:Key="SolidTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#324058"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 6. CLEAN SIDEBAR FILTER BUTTON -->
    <Style x:Key="SidebarFilterItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="itemBorder" CornerRadius="6" Background="{TemplateBinding Background}" Padding="12,0">
                        <Grid>
                            <!-- Active indicator bar -->
                            <Border x:Name="activeIndicator" HorizontalAlignment="Left" Width="3" Height="16" CornerRadius="1.5"
                                    Background="{StaticResource BrushPrimary}" Visibility="Collapsed" Margin="-12,0,0,0"/>

                            <ContentPresenter VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="#17202F"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="#1A2436"/>
                            <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
