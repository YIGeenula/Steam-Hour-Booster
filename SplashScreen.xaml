<Window x:Class="SteamPulse.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        x:Name="SplashWindow">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="SplashWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6"
                             EasingFunction="{x:Null}"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="SplashWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"
                             EasingFunction="{x:Null}"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="16"
            ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush Color="#0B0F17"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <!-- Brand Image -->
            <Image x:Name="BrandImg"
                   Source="pack://application:,,,/BrandImage.png"
                   Stretch="Uniform"
                   Width="480"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Subtle bottom gradient overlay -->
            <Rectangle VerticalAlignment="Bottom" Height="60" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#CC0B0F17" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Border>
</Window>
