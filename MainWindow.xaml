<Window x:Class="SteamPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SteamPulse.Converters"
        mc:Ignorable="d"
        Title="SteamPulse"
        Icon="softwareIcon.ico"
        Height="780" Width="1160"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontUi}">

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToActionBrushConverter x:Key="BoolToActionBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:BoolToVisibilityConverter x:Key="InvertBoolToVisConverter" Invert="True"/>
    </Window.Resources>

    <!-- Outer Window Border (Dark Deep Slate #0B0F17) with 1px border and soft depth shadow -->
    <Border Background="{StaticResource BrushWindowBg}"
            CornerRadius="12"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- 1. Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- 2. Update Notification Banner -->
                <RowDefinition Height="Auto"/> <!-- 3. Error / Warning Notification Banner -->
                <RowDefinition Height="*"/>    <!-- 4. Main Body (Sidebar + Library Grid) -->
                <RowDefinition Height="38"/>   <!-- 5. Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM TITLE BAR -->
            <Border Grid.Row="0" Background="#0C111A" MouseLeftButtonDown="TitleBar_MouseDown" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Branding: App Icon & Open Source Tag -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="softwareIcon.ico" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="STEAMPULSE" FontWeight="Black" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushElevated}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <TextBlock Text="OPEN SOURCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Search Filter Bar -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Height="32"
                            Background="{StaticResource BrushElevated}" CornerRadius="6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search Vector Icon -->
                            <Path Grid.Column="0" Data="M6.5,2 A4.5,4.5 0 1,0 6.5,11 A4.5,4.5 0 1,0 6.5,2 M10,10 L14,14"
                                  Stroke="{StaticResource BrushTextMuted}" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearchFilter" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="12" VerticalAlignment="Center"
                                     CaretBrush="{StaticResource BrushPrimary}" TextChanged="TxtSearchFilter_TextChanged"/>
                            <TextBlock Text="Filter your games..." Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TxtSearchFilter, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Window Control Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- GitHub Updates Button -->
                        <Button Style="{StaticResource TitleBarBtn}" Width="36" Click="BtnCheckUpdates_Click" ToolTip="Check for GitHub Updates">
                            <Path Data="M1,8 A7,7 0 1,1 8,15 L8,12 A4,4 0 1,0 4,8 L6,8 L2,4 L0,8 Z"
                                  Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Click="BtnTray_Click" ToolTip="Minimize to Tray">
                            <Path Data="M2,3 L8,3 L8,7 L2,7 Z M5,0 L5,2" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseBtn}" Click="BtnClose_Click" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. GITHUB UPDATE NOTIFICATION BANNER -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Background="#0C1F38" BorderBrush="{StaticResource BrushPrimary}" BorderThickness="0,0,0,1" Padding="18,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M0,8 L6,2 L12,8 L8,8 L8,14 L4,14 L4,8 Z" Fill="{StaticResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateBannerText" Grid.Column="1" Text="New SteamPulse version is available on GitHub!"
                               Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryActionBtn}" Content="Download Update" Height="30" Padding="12,0" Click="BtnDownloadUpdate_Click" Margin="0,0,8,0"/>
                        <Button Content="✕" Foreground="{StaticResource BrushTextSecondary}" Background="Transparent" BorderThickness="0"
                                Padding="8,4" Cursor="Hand" Click="DismissUpdateBanner_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. ERROR / WARNING BANNER -->
            <Border x:Name="NotificationBanner" Grid.Row="2" Background="{StaticResource BrushDangerSurface}" BorderBrush="{StaticResource BrushDangerBorder}" BorderThickness="0,0,0,1" Padding="18,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M8,1 L15,14 L1,14 Z M8,5 L8,9 M8,11 L8,12" Stroke="{StaticResource BrushDangerForeground}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NotificationText" Grid.Column="1" Foreground="{StaticResource BrushDangerForeground}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource DangerActionBtn}" Grid.Column="2" Content="Dismiss" Height="28" Padding="10,0" Click="DismissBanner_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 4. MAIN WORKSPACE (SIDEBAR + LIBRARY GRID) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource BrushSidebarBg}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0" Padding="16,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Metrics Card -->
                            <RowDefinition Height="Auto"/> <!-- Clean Navigation -->
                            <RowDefinition Height="*"/>    <!-- Add Game Box -->
                        </Grid.RowDefinitions>

                        <!-- Live Metrics Panel with Tabular Figures -->
                        <Border Grid.Row="0" Background="{StaticResource BrushPanelBg}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Active Count -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="MetricActiveCount" Text="0" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource BrushSuccess}" FontFamily="{StaticResource FontMono}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>

                                <!-- Total Games -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="GAMES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="MetricTotalGames" Text="0" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontMono}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>

                                <!-- Total Active Time -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource BrushElevated}" CornerRadius="6" Padding="8,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Clock Icon -->
                                        <Path Data="M7,1 A6,6 0 1,0 7,13 A6,6 0 1,0 7,1 M7,3 L7,7 L10,7"
                                              Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.2"
                                              Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="MetricTotalSessionTime" Text="00:00:00 Active" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource FontMono}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Clean Sidebar Navigation Filters (Fixed text clipping, pure vector icons) -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="LIBRARY FILTERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="4,0,0,8"/>

                            <!-- Filter 1: All Games -->
                            <RadioButton IsChecked="True" Style="{StaticResource SidebarFilterItem}" Checked="NavFilter_Checked" Tag="All">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M1,1 L5,1 L5,5 L1,5 Z M7,1 L11,1 L11,5 L7,5 Z M1,7 L5,7 L5,11 L1,11 Z M7,7 L11,7 L11,11 L7,11 Z"
                                          Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.2" Fill="Transparent" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="All Games" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Filter 2: Currently Boosting -->
                            <RadioButton Style="{StaticResource SidebarFilterItem}" Checked="NavFilter_Checked" Tag="Boosting">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M3,1 L11,6 L3,11 Z"
                                          Fill="{StaticResource BrushSuccess}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Currently Boosting" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Filter 3: Idle Games -->
                            <RadioButton Style="{StaticResource SidebarFilterItem}" Checked="NavFilter_Checked" Tag="Idle">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M2,1 L5,1 L5,11 L2,11 Z M7,1 L10,1 L10,11 L7,11 Z"
                                          Fill="{StaticResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Idle Games" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Add Game Widget -->
                        <Border Grid.Row="2" VerticalAlignment="Bottom" Background="{StaticResource BrushPanelBg}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ADD TO BOOST LIST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>

                                <TextBlock Text="Game Title" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,4"/>
                                <TextBox x:Name="TxtGameName" Style="{StaticResource SolidTextBox}" Height="34" Margin="0,0,0,10"/>

                                <TextBlock Text="Steam App ID" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,4"/>
                                <TextBox x:Name="TxtAppId" Style="{StaticResource SolidTextBox}" Height="34" Margin="0,0,0,14" PreviewTextInput="TxtAppId_PreviewTextInput"/>

                                <Button Style="{StaticResource PrimaryActionBtn}" Content="Add Game" Click="BtnAddGame_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN STAGE -->
                <Grid Grid.Column="1" Background="{StaticResource BrushWindowBg}" Margin="24,20,24,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Heading & Bulk Controls -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- Top Controls Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- View Heading -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtViewHeading" Text="My Boost Library" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Manage background playtime boosting for your Steam games" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Bulk Actions (Sync Library, Start All, Crimson Stop) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSyncSteam" Style="{StaticResource PrimaryActionBtn}" Background="#1E293B" Height="34" Padding="14,0" Margin="0,0,10,0" Click="BtnSyncSteam_Click" ToolTip="Detect and add games from your logged-in Steam account">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M1,6 A5,5 0 0,1 10,3 L10,1 L12,4 L9,6 L9,4 A4,4 0 0,0 2,6 Z M11,6 A5,5 0 0,1 2,9 L2,11 L0,8 L3,6 L3,8 A4,4 0 0,0 10,6 Z"
                                          Fill="{StaticResource BrushTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSyncSteam" Text="Sync Steam" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryActionBtn}" Height="34" Padding="16,0" Margin="0,0,10,0" Click="BtnStartAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L8,5 L0,10 Z" Fill="#FFFFFF" Width="8" Height="10" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Start All" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerActionBtn}" Height="34" Padding="16,0" Click="BtnStopAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L8,0 L8,8 L0,8 Z" Fill="{StaticResource BrushDangerForeground}" Width="8" Height="8" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stop All" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Cards Display Area -->
                    <Grid Grid.Row="1">
                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource BrushPanelBg}" HorizontalAlignment="Center" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <TextBlock Text="🎮" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No Games in this View" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Add games using the sidebar or adjust your search filter." FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Scrollable Cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Sharp Game Card with Solid Palette (#131924, 1px #232C3D) -->
                                        <Border Width="270" Height="320" Margin="0,0,18,20"
                                                Background="{StaticResource BrushCardBg}"
                                                CornerRadius="8"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushCardBgHover}"/>
                                                            <Setter Property="BorderBrush" Value="#384761"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="130"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top Cover Image Area (Consistent Height, Clipped, Guaranteed Overlay Order) -->
                                                <Grid Grid.Row="0" Height="130" ClipToBounds="True">
                                                    <Border Background="#0E121B" Panel.ZIndex="0">
                                                        <TextBlock Text="🎮" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25"/>
                                                    </Border>

                                                    <Image Source="{Binding HeaderImageUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>

                                                    <!-- Status / Ready Badge (Always on top with high-contrast backdrop) -->
                                                    <Border Panel.ZIndex="10"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                            Background="{StaticResource BrushBadgeBackdrop}" CornerRadius="4" Padding="8,4"
                                                            BorderBrush="{StaticResource BrushBadgeBorder}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding IsBoosting, Converter={StaticResource BoolToColorConverter}}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding IsBoosting, Converter={StaticResource BoolToColorConverter}}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- AppID Badge (Always on top with high-contrast backdrop) -->
                                                    <Border Panel.ZIndex="10"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                            Background="{StaticResource BrushBadgeBackdrop}" CornerRadius="4" Padding="6,3"
                                                            BorderBrush="{StaticResource BrushBadgeBorder}" BorderThickness="1">
                                                        <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource FontMono}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Card Body & Controls -->
                                                <Grid Grid.Row="1" Margin="14,10,14,14">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/> <!-- Game Title -->
                                                        <RowDefinition Height="*"/>    <!-- Session & Lifetime Times -->
                                                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                                    </Grid.RowDefinitions>

                                                    <!-- Game Title -->
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                               Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                                    <!-- Playtime Stats with Tabular Monospace Alignment -->
                                                    <Border Grid.Row="1" Background="{StaticResource BrushElevated}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" VerticalAlignment="Center" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Session Time (Jitter-free tabular font) -->
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="SESSION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                                                <TextBlock Text="{Binding SessionTimeDisplay}" FontSize="15" FontWeight="Bold"
                                                                           Foreground="{Binding IsBoosting, Converter={StaticResource BoolToColorConverter}}"
                                                                           FontFamily="{StaticResource FontMono}" Typography.NumeralAlignment="Tabular"/>
                                                            </StackPanel>

                                                            <!-- Lifetime Total -->
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                <TextBlock Text="LIFETIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding TotalBoostedDisplay}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                                           FontFamily="{StaticResource FontMono}" Typography.NumeralAlignment="Tabular"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Action Controls (Solid Blue BOOST / Solid Red STOP, and subtle remove button) -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- BOOST / STOP Button -->
                                                        <Button Grid.Column="0" Height="34" Cursor="Hand" Margin="0,0,8,0"
                                                                Click="BtnToggleGame_Click" Tag="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBd" CornerRadius="6" Background="{Binding IsBoosting, Converter={StaticResource BoolToActionBrushConverter}}">
                                                                        <TextBlock Text="{Binding ActionBtnText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBd" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- Delete Button (Dark-red surface with border) -->
                                                        <Button Style="{StaticResource DangerActionBtn}" Grid.Column="1" Height="34" Width="34"
                                                                Click="BtnDeleteGame_Click" Tag="{Binding}" ToolTip="Remove game from library">
                                                            <Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{StaticResource BrushDangerForeground}" StrokeThickness="1.5"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 5. BOTTOM STATUS BAR (No Clipping, Proper Margins) -->
            <Border Grid.Row="4" Background="#0C111A" Padding="16,0" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Steam Status Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SteamStatusDot" Width="7" Height="7" Fill="#EF4444" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SteamStatusText" Text="Steam Client: Initializing..." FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Version & Engine Badge (Cleanly padded to prevent bottom-right clipping) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="Steamworks 64-bit Engine" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushElevated}" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <TextBlock Text="v1.0.0 (Open Source)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
